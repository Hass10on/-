  "endings": [
    { "id": "legend", "title": "صافرة النهائي الكبير",
      "text": "أطلق {name} صافرة نهاية نهائي كأس العالم. من ملاعب الأحياء الترابية إلى أكبر مسرح في كرة القدم، بقيت قراراته نظيفة وصوته هادئاً. المسيرة اكتملت." },
    { "id": "retired_international", "title": "اعتزال حكم دولي",
      "text": "بلغ {name} سن الاعتزال وهو يحمل الشارة الدولية. لم يصل إلى نهائي كأس العالم، لكن اسمه بقي مرادفاً للنزاهة في كل ملعب دخله." },
    { "id": "retired", "title": "اعتزال",
      "text": "بلغ {name} سن الاعتزال. مسيرة طويلة من صافرات الأمسيات والملاعب الصغيرة، وجيل من اللاعبين يتذكر حكماً لم يهتز." },
    { "id": "banned", "title": "إيقاف مدى الحياة",
      "text": "أثبتت وحدة النزاهة تلاعب {name} بنتائج المباريات. صدر قرار بإيقافه عن أي نشاط كروي مدى الحياة، وأُحيل ملفه إلى النيابة." },
    { "id": "confessed", "title": "الاعتراف",
      "text": "اعترف {name} بكل شيء وساعد المحققين على تفكيك شبكة التلاعب. أُوقف عن التحكيم، لكن شهادته أسقطت من أفسدوا اللعبة." },
    { "id": "dismissed", "title": "سحب الرخصة",
      "text": "فقد الاتحاد ثقته بـ{name} وسحب رخصة التحكيم. ربما تعود يوماً من بوابة أخرى." },
    { "id": "burnout", "title": "استنزاف",
      "text": "الضغط والإساءات استنزفا {name}. قرر الابتعاد عن الملاعب ليحمي صحته وعائلته. لا عيب في ذلك." },
    { "id": "pundit", "title": "من الملعب إلى الاستوديو",
      "text": "قبل {name} عرض القناة وأصبح المحلل التحكيمي الأشهر. الآن يحكم على قرارات غيره من خلف الشاشة." }
  ]
}
